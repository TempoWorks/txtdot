{% if search %}
  <input type="checkbox" id="switch-search" {% if search_by_default %}checked{% endif %}>

  <label for="switch-search" class="switch-label">
    <span>URL</span>
    <span class="switch-btn"></span>
    <span>Search</span>
  </label>

  <form action="/search" method="get" class="input-grid main-form-search">
    {% include "components/search-form.tera" %}
    <details class="options-menu">
      <summary class="button secondary">Options</summary>
      <div class="options-panel">
        <label class="image-option">
          <input type="checkbox" name="highlight_code" value="true" checked>
          <span>Highlight code</span>
        </label>
        {% include "components/proxy-options.tera" %}
      </div>
    </details>
  </form>
{% endif %}

<form action="/get" method="get" class="input-grid {% if search %}main-form-url{% endif %}">
  <div class="input">
    <input type="text" name="url" id="url" placeholder="URL" autofocus>
  </div>
  <div class="input">
    <input type="submit" id="submit" class="button" value="Parse">
  </div>
  <div class="input-row">
    <div class="input">
      <label for="format">Format</label>
      <select name="format">
        <option value="html" selected>HTML</option>
        <option value="daletpack">Daletpack</option>
      </select>
    </div>
    <details class="options-menu">
      <summary class="button secondary">Options</summary>
      <div class="options-panel">
        <label class="image-option">
          <input type="checkbox" name="highlight_code" value="true" checked>
          <span>Highlight code</span>
        </label>
        {% include "components/proxy-options.tera" %}
      </div>
    </details>
  </div>
</form>
