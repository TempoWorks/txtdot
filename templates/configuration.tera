<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="description" content="{{ description }}">
    <title>txt. configuration</title>
    <link rel="stylesheet" href="/static/common.css">
    <link rel="stylesheet" href="/static/configuration.css">
  </head>
  <body>
    <main>
      <header>
        <h1>txt<span class="dot">.</span></h1>
        <div class="menu">
          <a class="button secondary" href="/">Home</a>
        </div>
        <p>{{ description }}</p>
      </header>
      <div>
        {{ badge | safe }}
      </div>
      <div class="configuration">
        <h2>Configuration</h2>
        <pre>  version: {{ version }}{{ env_pretty }}</pre>
        <h2>Supported protocols</h2>
        <ol>
          {% for protocol in protocols %}
            <li>{{ protocol }}</li>
          {% endfor %}
        </ol>
        <h2>Supported inputs</h2>
        <ol>
          {% for input in inputs %}
            <li>{{ input }}</li>
          {% endfor %}
        </ol>
        <h2>Supported outputs</h2>
        <ol>
          {% for output in outputs %}
            <li>{{ output }}</li>
          {% endfor %}
        </ol>
        <h2>Available engines</h2>
        <ol>
          {% for engine in engines %}
            <li>{{ engine.name }}: {{ engine.description }}</li>
          {% endfor %}
        </ol>
        <h2>Available middlewares</h2>
        <ol>
          {% for middleware in middlewares %}
            <li>{{ middleware.name }}: {{ middleware.description }}</li>
          {% endfor %}
        </ol>
        <h2>Available routes</h2>
        {% for route in routes %}
          <a class="button secondary" href="{{ route }}">{{ route }}</a>
        {% endfor %}
      </div>
    </main>
  </body>
</html>
