{
  "name": "@txtdot/server",
  "version": "1.10.7",
  "private": true,
  "description": "txtdot is an HTTP proxy that parses only text, links and pictures from pages reducing internet bandwidth usage, removing ads and heavy scripts",
  "main": "dist/app.js",
  "keywords": [],
  "authors": [
    "Artemy Egorov <me@artegoser.ru> https://github.com/artegoser",
    "DarkCat09 <darkcat09@vivaldi.net> https://dc09.ru/"
  ],
  "license": "MIT",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "node scripts/build-assets.js && tsc",
    "start": "cd ./dist && node ./src/app.js",
    "dev": "tsc-watch --onSuccess \"node ./dist/src/app.js\""
  },
  "dependencies": {
    "@fastify/one-line-logger": "^2.2.1",
    "@fastify/static": "10.1.8",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/view": "^12.0.1",
    "@txtdot/plugins": "workspace:*",
    "@txtdot/sdk": "workspace:*",
    "axios": "^1.21.0",
    "dotenv": "^18.0.9",
    "ejs": "^7.0.2",
    "fastify": "^5.12.7",
    "iconv-lite": "^0.7.3",
    "ip-range-check": "^0.2.1",
    "isomorphic-dompurify": "^4.6.0",
    "json-schema-to-ts": "^3.1.1",
    "linkedom": "^0.18.15",
    "micromatch": "^4.0.8",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/jsdom": "^30.0.0",
    "@types/micromatch": "^4.0.10",
    "clean-css": "^5.3.3"
  }
}
